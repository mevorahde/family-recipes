{
  "name": "family-recipes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:firestore": "npm --prefix functions run build && firebase emulators:exec --project demo-family-recipes --only firestore \"node --test --test-concurrency=1 tests/firestore/*.test.mjs\"",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "^1.29.0",
    "firebase": "^13.0.0",
    "js-yaml": "^5.5.0",
    "mammoth": "^1.13.0",
    "postal-mime": "^4.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "15.34.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
